# RootTrace Mobile — Environment Configuration
# Copy this file to .env.local and replace with your actual values.
# NEVER hardcode localhost here — the device needs your machine's LAN IP.

# Your RootTrace backend host:port reachable from the physical device on the same LAN.
# Find your IP with: ipconfig (Windows) or ip addr (Linux)
EXPO_PUBLIC_API_BASE_URL=http://192.168.x.x:8000
