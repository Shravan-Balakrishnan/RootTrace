# RootTrace Environment Configuration
PORT=8000
HOST=127.0.0.1
ENV=development

# Demo Operator Passwords (Server-Side Authentication & Authorization)
# Configure secure passwords for local demonstration sessions. Do not commit actual production secrets to VCS.
ROOTTRACE_DEMO_LEAD_SRE_PASSWORD=YourStrongLeadSREPassword2026!
ROOTTRACE_DEMO_CMD_PASSWORD=YourStrongCmdPassword2026!
ROOTTRACE_DEMO_ONCALL_PASSWORD=YourStrongOnCallPassword2026!
ROOTTRACE_DEMO_STAFF_PASSWORD=YourStrongStaffPassword2026!
ROOTTRACE_DEMO_INTERN_PASSWORD=YourStrongInternPassword2026!

# Strict Security Enforcement (set to 1 or true in production environments to require credentials)
ROOTTRACE_STRICT_AUTH=0

# Session Storage SQLite Database Path
ROOTTRACE_SESSION_DB=backend/app/safety/sessions.db

# Optional External Cloud LLM API Key (Defaults to offline deterministic reasoning if omitted)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=15.0
